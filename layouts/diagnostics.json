{
  "version": "1.30.4",
  "type": "session",
  "content": {
    "type": "root",
    "id": "diag_root",
    "widgets": [
      {
        "type": "panel",
        "id": "diag_panel",
        "label": "Diagnostics",
        "layout": "vertical",
        "width": 520,
        "height": 560,
        "padding": 12,
        "scroll": true,
        "widgets": [
          {
            "type": "text",
            "id": "diag_heading",
            "default": "Debug telemetry exposed by the custom module.",
            "interaction": false
          },
          {
            "type": "text",
            "id": "diag_reachability",
            "label": "Reachability",
            "address": "/surface/diag/reachability",
            "default": "-",
            "interaction": false
          },
          {
            "type": "text",
            "id": "diag_rtt",
            "label": "RTT",
            "address": "/surface/diag/rtt",
            "default": "-",
            "interaction": false
          },
          {
            "type": "text",
            "id": "diag_loss_rate",
            "label": "Loss Rate",
            "address": "/surface/diag/loss-rate",
            "default": "-",
            "interaction": false
          },
          {
            "type": "text",
            "id": "diag_subnet",
            "label": "Subnet",
            "address": "/surface/diag/subnet",
            "default": "-",
            "interaction": false
          },
          {
            "type": "text",
            "id": "diag_log_usage",
            "label": "Log Usage",
            "address": "/surface/diag/log-usage",
            "default": "-",
            "interaction": false
          },
          {
            "type": "text",
            "id": "diag_messages",
            "label": "Recent Messages",
            "address": "/surface/diag/messages",
            "default": "No diagnostic messages yet.",
            "interaction": false
          },
          {
            "type": "button",
            "id": "diag_purge",
            "label": "古いログを削除",
            "address": "/surface/diag/purge",
            "target": ["127.0.0.1:9"]
          }
        ]
      }
    ]
  }
}
