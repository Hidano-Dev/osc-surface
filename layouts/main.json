{
  "version": "1.30.4",
  "type": "session",
  "content": {
    "type": "root",
    "id": "root",
    "widgets": [
      {
        "type": "panel",
        "id": "manifest_fixed",
        "label": "Manifest Surface",
        "layout": "vertical",
        "left": 20,
        "top": 20,
        "width": 420,
        "height": 460,
        "widgets": [
          {
            "type": "text",
            "id": "manifest_heading",
            "default": "Fixed widgets mapped from the manifest",
            "interaction": false
          },
          {
            "type": "fader",
            "id": "smile_blend",
            "label": "Smile",
            "address": "/avatar/blend/smile",
            "range": { "min": 0, "max": 1 }
          },
          {
            "type": "text",
            "id": "character_name",
            "label": "Character Name",
            "address": "/avatar/text/name",
            "interaction": false
          },
          {
            "type": "button",
            "id": "visible_toggle",
            "label": "Visible",
            "address": "/avatar/toggle/visible",
            "mode": "toggle",
            "on": 1,
            "off": 0
          }
        ]
      },
      {
        "type": "panel",
        "id": "dynamic",
        "label": "Generated Widgets",
        "layout": "vertical",
        "left": 470,
        "top": 20,
        "width": 430,
        "height": 460,
        "widgets": [
          {
            "type": "text",
            "id": "dynamic_placeholder",
            "default": "Generated manifest widgets appear here.",
            "interaction": false
          }
        ]
      },
      {
        "type": "modal",
        "id": "diag_modal",
        "label": "Diagnostics",
        "popupLabel": "Diagnostics",
        "layout": "vertical",
        "left": 20,
        "top": 500,
        "width": 180,
        "height": 40,
        "popupWidth": 560,
        "popupHeight": "80%",
        "widgets": [
          {
            "type": "fragment",
            "id": "diag_fragment",
            "file": "diagnostics.json"
          }
        ]
      }
    ]
  }
}
