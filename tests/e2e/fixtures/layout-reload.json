{
  "version": "1.30.4",
  "type": "session",
  "content": {
    "type": "root",
    "id": "root",
    "widgets": [
      { "type": "panel", "id": "manifest_fixed", "layout": "vertical", "widgets": [
        { "type": "fader", "id": "smile_blend", "address": "/avatar/blend/smile", "range": { "min": 0, "max": 1 } },
        { "type": "text", "id": "character_name", "address": "/avatar/text/name", "interaction": false },
        { "type": "button", "id": "dyn_avatar_generated_wave", "label": "Manual widget" }
      ] },
      { "type": "panel", "id": "dynamic", "layout": "vertical", "widgets": [
        { "type": "text", "id": "dynamic_placeholder", "interaction": false }
      ] },
      { "type": "modal", "id": "diag_modal", "label": "Diagnostics", "popupLabel": "Diagnostics", "widgets": [
        { "type": "fragment", "id": "diag_fragment", "file": "diagnostics.json" }
      ] }
    ]
  }
}
