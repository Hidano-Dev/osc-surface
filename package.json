{
  "name": "oscdesk",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "typecheck": "corepack pnpm -r run typecheck",
    "test": "corepack pnpm -r --if-present run build && vitest run --config vitest.config.ts && node scripts/run-python-tests.mjs",
    "osc:build": "npm --prefix vendor/open-stage-control run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "osc": "^2.4.5",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
